<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plugin identity and manifest metadata live in Plugin.props (single source of truth). -->
  <Import Project="..\Plugin.props" />

  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <RootNamespace>NINA.Plugin.SmartSwitchManager</RootNamespace>
    <AssemblyName>NINA.Plugin.SmartSwitchManager</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NINA.Plugin" Version="$(NINAVersion)" />
    <PackageReference Include="NINA.WPF.Base" Version="$(NINAVersion)" />
    <PackageReference Include="System.ComponentModel.Composition" Version="8.0.0" />
    <ProjectReference Include="..\NINA.Plugin.SmartSwitchManager.Core\NINA.Plugin.SmartSwitchManager.Core.csproj" />

    <!-- Every provider project under Providers/<Name>/ is built with the plugin (we don't use them in code) and
         packaged to Backends/<Name>/ by build/Plugin.targets. A new provider needs no entry here. -->
    <ProjectReference Include="..\Providers\*\*.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="plugin_logo.png" />
  </ItemGroup>

  <!-- Staging, local deployment (DeployPlugin) and release packaging (PackagePlugin). Replaces the old PostBuild xcopy. -->
  <Import Project="..\build\Plugin.targets" />
</Project>
