<Project>
  <!-- This is the single editable source of plugin identity and manifest metadata. -->
  <PropertyGroup>
    <!-- Do NOT change after the first release: it identifies the plugin across all versions. -->
    <PluginId>a1b2c3d4-e5f6-7890-abcd-ef1234567890</PluginId>
    <Version Condition="'$(Version)' == ''">1.0.0.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <Title>Smart Switch Manager</Title>
    <AssemblyTitle>$(Title)</AssemblyTitle>
    <Product>$(Title)</Product>
    <Copyright>Copyright © 2026 Dirk Morlak</Copyright>
    <Company>Dirk Morlak</Company>
    <Authors>Dirk Morlak</Authors>
    <Description>Manage smart home switches (Shelly, Tasmota, HA, ESPHome) as native N.I.N.A. equipment.</Description>
    <PluginLongDescription># Smart Switch Manager

Integrate your IoT power relays directly into your astrophotography workflow. Control equipment power manually or automate it via the Advanced Sequencer.

### Supported Systems
* **Shelly:** Gen 1, Gen 2/3 (Plus &amp; Pro) via HTTP/RPC APIs
* **Home Assistant:** Full integration via REST API &amp; Long-Lived Access Tokens (LLAT)
* **Tasmota:** Control via the HTTP Command API
* **ESPHome:** Seamless integration via the web_server component

### Key Features
* **Native Equipment:** Appears directly in the **Equipment &gt; Switch** tab.
* **Sequencer Ready:** Dedicated instructions to toggle power during your sequences.
* **Device Discovery:** Built-in scanners to find your Shelly and Tasmota devices on the network.

---

*For detailed setup and developer info, please visit the [GitHub Repository](https://github.com/DIYAstro-Obs/NINA.Plugin.SmartSwitchManager).*</PluginLongDescription>
    <RepositoryUrl>https://github.com/DIYAstro-Obs/NINA.Plugin.SmartSwitchManager</RepositoryUrl>
    <PluginHomepage>https://github.com/DIYAstro-Obs/NINA.Plugin.SmartSwitchManager</PluginHomepage>
    <PluginTags>Switch,Shelly,SmartHome,Relay,IoT</PluginTags>
    <!-- Lowest N.I.N.A. version this plugin is built and tested against. The net8 build also loads in 3.3. -->
    <MinimumNinaVersion>3.2.0.9001</MinimumNinaVersion>
    <PluginLicense>MPL-2.0</PluginLicense>
    <PluginLicenseUrl>https://www.mozilla.org/en-US/MPL/2.0/</PluginLicenseUrl>
    <PluginChangelogUrl>https://github.com/DIYAstro-Obs/NINA.Plugin.SmartSwitchManager/commits/main/</PluginChangelogUrl>
    <!-- These end up in the online manifest, so they must be public https URLs (not pack:// URIs). -->
    <PluginFeaturedImageUrl>https://raw.githubusercontent.com/DIYAstro-Obs/NINA.Plugin.SmartSwitchManager/main/NINA.Plugin.SmartSwitchManager/plugin_logo.png</PluginFeaturedImageUrl>
    <PluginScreenshotUrl>https://raw.githubusercontent.com/DIYAstro-Obs/NINA.Plugin.SmartSwitchManager/main/NINA.Plugin.SmartSwitchManager/screenshot.png</PluginScreenshotUrl>
    <PluginAltScreenshotUrl></PluginAltScreenshotUrl>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute"><_Parameter1>$(PluginId)</_Parameter1></AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute"><_Parameter1>false</_Parameter1></AssemblyAttribute>
    <AssemblyMetadata Include="MinimumApplicationVersion" Value="$(MinimumNinaVersion)" />
    <AssemblyMetadata Include="License" Value="$(PluginLicense)" />
    <AssemblyMetadata Include="LicenseURL" Value="$(PluginLicenseUrl)" />
    <AssemblyMetadata Include="Repository" Value="$(RepositoryUrl)" />
    <AssemblyMetadata Include="Homepage" Value="$(PluginHomepage)" />
    <AssemblyMetadata Include="Tags" Value="$(PluginTags)" />
    <AssemblyMetadata Include="LongDescription" Value="$(PluginLongDescription)" />
    <AssemblyMetadata Include="ChangelogURL" Value="$(PluginChangelogUrl)" />
    <AssemblyMetadata Include="FeaturedImageURL" Value="$(PluginFeaturedImageUrl)" />
    <AssemblyMetadata Include="ScreenshotURL" Value="$(PluginScreenshotUrl)" />
    <AssemblyMetadata Include="AltScreenshotURL" Value="$(PluginAltScreenshotUrl)" />
  </ItemGroup>
</Project>
