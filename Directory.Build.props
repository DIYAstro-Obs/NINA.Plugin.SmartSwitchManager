<Project>
  <PropertyGroup>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <Platforms>x64</Platforms>
    <!-- The solution maps "Any CPU" to x64. Make direct project builds (dotnet msbuild <proj> -t:PackagePlugin) match it. -->
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <Authors>Dirk Morlak</Authors>
    <Company>Dirk Morlak</Company>
    <Copyright>Copyright © 2026 Dirk Morlak</Copyright>
    <NINAVersion>3.2.0.9001</NINAVersion>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
</Project>
